# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# MongoDB (local Docker Compose defaults; replace credentials for hosted deployment)
MONGO_ROOT_USERNAME=syf_app
MONGO_ROOT_PASSWORD=ChangeThisMongoPass123456789
MONGODB_URI=mongodb://syf_app:ChangeThisMongoPass123456789@localhost:27017/?authSource=admin
MONGODB_DB_NAME=santosh_yadav_fitness
MONGODB_STORE_COLLECTION=application_state
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10

# Redis (local Docker Compose defaults; use a private TLS URL in production)
REDIS_PASSWORD=ChangeThisRedisPass123456789
REDIS_URL=redis://:ChangeThisRedisPass123456789@localhost:6379
REDIS_CONNECT_TIMEOUT_MS=10000

# Admin: generate a scrypt hash with `npm run admin:hash -- "your-long-password"`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_MAX_ATTEMPTS=8
ADMIN_LOGIN_WINDOW_MS=900000

# Razorpay (test keys locally; live keys only in production secret manager)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional payment simulation for localhost development only; never enable on a public host
ENABLE_LOCAL_TEST_PAYMENT_SANDBOX=false

# Site and product configuration (used as initial values when MongoDB is first initialized)
BRAND_NAME=Santosh Yadav Fitness
WHATSAPP_NUMBER=918770423010
SUPPORT_EMAIL=your-support-email@example.com
INSTAGRAM_URL=https://www.instagram.com/santosh_yadav_fitness/
YOUTUBE_URL=https://www.youtube.com/@desigymfitness/
INSTAGRAM_FOLLOWERS=2.6 M+
YOUTUBE_SUBSCRIBERS=3.5 M+
TOTAL_AUDIENCE=6.0 M+
HERO_HEADLINE=Fat Loss Ho Ya Weight Gain — Apni Diet Ko Do Ek Clear Direction.
HERO_DESCRIPTION=Apne fitness goal ke according choose karo ek practical diet plan. Simple food guidance, easy-to-follow meal structure aur daily routine ko dhyan mein rakhkar banaye gaye PDF plans — taaki aap apni eating habits ko better direction de sako.
PRODUCT_FATLOSS_NAME=Fat Loss Diet Plan
PRODUCT_FATLOSS_DESCRIPTION=Simple Indian diet guide for a sustainable fat-loss routine.
PRODUCT_FATLOSS_PDF_FILENAME=fat-loss-diet-plan.pdf
PRODUCT_FATLOSS_PRICE_PAISE=19900
PRODUCT_WEIGHT_GAIN_NAME=Weight Gain Diet Plan
PRODUCT_WEIGHT_GAIN_DESCRIPTION=Affordable Indian food guide for healthy weight gain.
PRODUCT_WEIGHT_GAIN_PDF_FILENAME=weight-gain-diet-plan.pdf
PRODUCT_WEIGHT_GAIN_PRICE_PAISE=19900

# Google Sheets (optional)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
